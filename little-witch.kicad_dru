(version 1)
(rule Minimum_clearance_1
	(constraint clearance (min 0.127mm))
)
(rule Outer_layer_less_edge_clearance
    (condition "A.Layer == 'outer'")
	(constraint edge_clearance (min 0.254mm))
)
(rule Ethernet_MDI_skew
	(condition "A.hasNetclass('MDI') && AB.isCoupledDiffPair()")
	(constraint skew (min -50mil) (max 50mil))
)